{
  "name": "real-debrid-manager",
  "description": "Capture links, manage torrents, and run your Real-Debrid account from the browser",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "wxt build && PW_EXPERIMENTAL_SERVICE_WORKER_NETWORK_EVENTS=1 bun e2e/screenshots.ts",
    "postinstall": "wxt prepare",
    "format": "prettier --write src wxt.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@webext-core/messaging": "^4.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  }
}
